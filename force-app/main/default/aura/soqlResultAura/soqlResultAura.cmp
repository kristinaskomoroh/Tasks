<aura:component>
    <aura:attribute name="data" type="List" default="[]"/>
    <aura:attribute name="columns" type="List" default="[]"/>
    <aura:attribute name="visibleData" type="List" default="[]"/>
    <aura:attribute name="sortedBy" type="String"/>
    <aura:attribute name="sortedDirection" type="String" default="asc"/>
    <aura:attribute name="currentPage" type="Integer" default="1"/>
    <aura:attribute name="pageSize" type="Integer" default="5"/>
    <aura:attribute name="totalPages" type="Integer" default="1"/>

    <aura:handler name="change" value="{!v.data}" action="{!c.handleDataChange}"/>
    <aura:if isTrue="{!not(empty(v.data))}">
        <div class="slds-m-top_medium" style="background: white; border-radius: 10px; padding: 10px;">
            <lightning:datatable keyField="Id" data="{!v.visibleData}" columns="{!v.columns}" hideCheckboxColumn="true" onsort="{!c.handleSort}" sortedBy="{!v.sortedBy}" sortedDirection="{!v.sortedDirection}"></lightning:datatable>
        </div>
         <div class="slds-m-top_medium slds-grid slds-grid_align-center">
            <lightning:button label="Prev" onclick="{!c.prevPage}" disabled="{!v.currentPage == 1}"></lightning:button>
            <span class="slds-p-horizontal_small">
                 Page {!v.currentPage} of {!v.totalPages}
            </span>
            <lightning:button label="Next" onclick="{!c.nextPage}" disabled="{!v.currentPage == v.totalPages}"></lightning:button>
        </div>
    </aura:if>
</aura:component> 